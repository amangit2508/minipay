datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum TransactionType {
  PAYMENT
  REFUND
  CHARGEBACK
  PAYOUT
}

model Merchant {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  apiKey        String   @unique @default(uuid())
  webhookUrl    String?
  webhookSecret String   @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments      Payment[]
  transactions  Transaction[]
  webhookEvents WebhookEvent[]

  @@index([apiKey])
}

model Payment {
  id             String        @id @default(uuid())
  merchantId     String
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING)
  paymentMethod  String        @default("UPI")
  customerPhone  String?
  vpa            String?
  bankAccount    String?
  ifscCode       String?
  customerEmail  String?
  description    String?
  idempotencyKey String?       @unique
  providerTxId   String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  merchant     Merchant      @relation(fields: [merchantId], references: [id])
  transactions Transaction[]

  @@index([merchantId, status])
  @@index([customerPhone])
  @@index([createdAt])
}

model Transaction {
  id         String          @id @default(uuid())
  merchantId String
  paymentId  String
  type       TransactionType @default(PAYMENT)
  amount     Decimal         @db.Decimal(12, 2)
  fee        Decimal         @default(0.00) @db.Decimal(12, 2)
  net        Decimal         @db.Decimal(12, 2)
  currency   String          @default("INR")
  createdAt  DateTime        @default(now())

  merchant Merchant @relation(fields: [merchantId], references: [id])
  payment  Payment  @relation(fields: [paymentId], references: [id])

  @@index([merchantId, createdAt])
}

model IdempotencyRecord {
  key          String   @id
  merchantId   String
  requestHash  String
  responseCode Int
  responseBody Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([expiresAt])
}

model WebhookEvent {
  id         String            @id @default(uuid())
  merchantId String
  eventType  String
  payload    Json
  createdAt  DateTime          @default(now())
  deliveries WebhookDelivery[]

  merchant Merchant @relation(fields: [merchantId], references: [id])
}

model WebhookDelivery {
  id             String    @id @default(uuid())
  webhookEventId String
  status         String
  responseStatus Int?
  responseBody   String?
  attempts       Int       @default(0)
  nextRetryAt    DateTime?
  createdAt      DateTime  @default(now())

  webhookEvent WebhookEvent @relation(fields: [webhookEventId], references: [id])

  @@index([status, nextRetryAt])
}
